{
  "name": "visual-image-search-in-blockchain-storage",
  "version": "1.0.0",
  "private": true,
  "description": "Hardhat project for image registry, licensing, and audit contracts on Polygon.",
  "scripts": {
    "prepare": "node scripts/install-git-hooks.js",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:coverage": "hardhat test --coverage",
    "lint:solidity": "solhint \"contracts/**/*.sol\"",
    "check:coverage": "node scripts/check-coverage.js",
    "check:commit": "node scripts/check-quality.js",
    "clean": "hardhat clean",
    "deploy:amoy": "hardhat run scripts/deploy.js --network amoy",
    "deploy:polygon": "hardhat run scripts/deploy.js --network polygon",
    "measure:register-collection-confirmation": "hardhat run scripts/measure-register-collection-confirmation.js",
    "measure:register-collection-gas-by-record-count": "hardhat run scripts/measure-register-collection-gas-by-record-count.js",
    "benchmark:local-system-test": "node scripts/benchmark-local-system-test.js",
    "benchmark:centralized-system-test": "node scripts/benchmark-centralized-system-test.js",
    "plot:register-collection-confirmation": "python scripts/plot_register_collection_confirmation_histogram.py",
    "plot:register-collection-gas-by-record-count": "python scripts/plot_register_collection_gas_by_record_count.py",
    "plot:local-system-benchmark": "python scripts/plot_local_system_benchmark.py",
    "amoy:create-license-setup": "hardhat run scripts/amoy-create-license-setup.js --network amoy",
    "amoy:buy-license": "hardhat run scripts/amoy-buy-license.js --network amoy"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.5",
    "hardhat-gas-reporter": "^1.0.10",
    "hardhat": "^2.26.3",
    "solhint": "^6.2.4"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0"
  }
}